{
  "name": "@kaspascopio/emdash-kaspa-x402",
  "version": "0.1.0",
  "private": true,
  "description": "Community Kaspa x402 backend adapter for EmDash",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "proof:tn10": "npm run build && node scripts/proof-tn10-e2e.mjs",
    "proof:facilitator-rc2": "node scripts/proof-facilitator-rc2.mjs",
    "proof:emdash-http-rc2": "node scripts/proof-emdash-http-rc2.mjs",
    "proof:emdash-atomic-http-rc2": "node scripts/proof-emdash-atomic-http-rc2.mjs",
    "proof:durable-content-sqlite": "node scripts/proof-durable-content-sqlite.mjs"
  },
  "peerDependencies": {
    "@kaspa-x402/core": ">=0.1.0-alpha.10"
  },
  "devDependencies": {
    "@kaspa-x402/core": "1.0.0-rc.2",
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "tsup": {
      "esbuild": "0.28.1"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KaspaScopio/emdash-kaspa-x402-adapter.git"
  },
  "homepage": "https://github.com/KaspaScopio/emdash-kaspa-x402-adapter#readme",
  "bugs": {
    "url": "https://github.com/KaspaScopio/emdash-kaspa-x402-adapter/issues"
  }
}
